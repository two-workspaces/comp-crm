{
  "buckets": {},
  "services": {
    "44c1ae76-cc5a-4e44-b1d7-1b710b783a25": {
      "icon": "https://raw.githubusercontent.com/trycompai/crm/v1.16.0/apps/app/public/web-app-manifest-512x512.png",
      "name": "CRM",
      "source": {
        "image": "ghcr.io/two-workspaces/comp-crm:6e9ed2c"
      },
      "deploy": {
        "healthcheckPath": "/sign-in",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "variables": {
        "CRM_ROLE": {
          "isOptional": false,
          "description": "Runs the web app. Do not change.",
          "defaultValue": "app"
        },
        "DATABASE_URL": {
          "isOptional": false,
          "description": "Postgres connection.",
          "defaultValue": "${{Postgres.DATABASE_URL}}"
        },
        "BETTER_AUTH_SECRET": {
          "isOptional": false,
          "description": "Shared with the API, which signs sessions.",
          "defaultValue": "${{API.BETTER_AUTH_SECRET}}"
        },
        "ALLOWED_SIGN_IN": {
          "isOptional": false,
          "description": "Set on the API service.",
          "defaultValue": "${{API.ALLOWED_SIGN_IN}}"
        },
        "AGENT_BRIDGE_SECRET": {
          "isOptional": false,
          "description": "Shared with the API and the agent.",
          "defaultValue": "${{API.AGENT_BRIDGE_SECRET}}"
        },
        "MCP_ENCRYPTION_KEY": {
          "isOptional": false,
          "description": "Shared with the API.",
          "defaultValue": "${{API.MCP_ENCRYPTION_KEY}}"
        },
        "CHAT_EVENT_ENCRYPTION_KEY": {
          "isOptional": false,
          "description": "Shared with the API.",
          "defaultValue": "${{API.CHAT_EVENT_ENCRYPTION_KEY}}"
        },
        "GOOGLE_CLIENT_ID": {
          "isOptional": false,
          "description": "Set on the API service.",
          "defaultValue": "${{API.GOOGLE_CLIENT_ID}}"
        },
        "GOOGLE_CLIENT_SECRET": {
          "isOptional": false,
          "description": "Set on the API service.",
          "defaultValue": "${{API.GOOGLE_CLIENT_SECRET}}"
        },
        "API_URL": {
          "isOptional": false,
          "description": "Public origin of the auth routes, which this app proxies to the API. Do not change.",
          "defaultValue": "https://${{CRM.RAILWAY_PUBLIC_DOMAIN}}"
        },
        "APP_URL": {
          "isOptional": false,
          "description": "Public address of the CRM. Change it to https://your-domain after adding a custom domain, here and on the API.",
          "defaultValue": "https://${{CRM.RAILWAY_PUBLIC_DOMAIN}}"
        },
        "CRM_API_INTERNAL_URL": {
          "isOptional": false,
          "description": "The API on the private network; the app's /api proxy calls it.",
          "defaultValue": "http://${{API.RAILWAY_PRIVATE_DOMAIN}}:3001"
        },
        "AGENT_URL": {
          "isOptional": false,
          "description": "The research agent on the private network.",
          "defaultValue": "http://${{Agent.RAILWAY_PRIVATE_DOMAIN}}:2000"
        },
        "PORT": {
          "isOptional": false,
          "description": "Port of the web app. Do not change.",
          "defaultValue": "3000"
        }
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>:3000": {
            "port": 3000
          }
        },
        "tcpProxies": {}
      }
    },
    "9bc4181b-fb88-4f92-ba69-efc84fa3608e": {
      "icon": "https://raw.githubusercontent.com/trycompai/crm/v1.16.0/apps/app/public/web-app-manifest-512x512.png",
      "name": "API",
      "source": {
        "image": "ghcr.io/two-workspaces/comp-crm:6e9ed2c"
      },
      "deploy": {
        "healthcheckPath": "/health",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "variables": {
        "CRM_ROLE": {
          "isOptional": false,
          "description": "Runs the API. Do not change.",
          "defaultValue": "api"
        },
        "ALLOWED_SIGN_IN": {
          "isOptional": false,
          "description": "Who may sign in: your email address, or your company's domain (acme.com). Comma-separate several. This is the whole access control.",
          "defaultValue": ""
        },
        "GOOGLE_CLIENT_ID": {
          "isOptional": true,
          "description": "Google OAuth client id. Sign-in needs Google or Microsoft: create a Web client at console.cloud.google.com with the redirect URI https://your-crm-domain/api/auth/callback/google.",
          "defaultValue": ""
        },
        "GOOGLE_CLIENT_SECRET": {
          "isOptional": true,
          "description": "Google OAuth client secret, set together with the id.",
          "defaultValue": ""
        },
        "MICROSOFT_CLIENT_ID": {
          "isOptional": true,
          "description": "Instead of or next to Google: a Microsoft Entra app id, with the redirect URI https://your-crm-domain/api/auth/callback/microsoft.",
          "defaultValue": ""
        },
        "MICROSOFT_CLIENT_SECRET": {
          "isOptional": true,
          "description": "Microsoft client secret, set together with the id.",
          "defaultValue": ""
        },
        "DATABASE_URL": {
          "isOptional": false,
          "description": "Postgres connection.",
          "defaultValue": "${{Postgres.DATABASE_URL}}"
        },
        "BETTER_AUTH_SECRET": {
          "isOptional": false,
          "description": "Signs sessions. Changing it signs everyone out.",
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}"
        },
        "AGENT_BRIDGE_SECRET": {
          "isOptional": false,
          "description": "Lets the app and API talk to the research agent.",
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}"
        },
        "CRON_SECRET": {
          "isOptional": false,
          "description": "Guards the scheduled sync routes the Cron service calls.",
          "defaultValue": "${{secret(40, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}"
        },
        "MCP_ENCRYPTION_KEY": {
          "isOptional": false,
          "description": "Encrypts MCP connection tokens. Never change it once connections exist.",
          "defaultValue": "${{secret(43, \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\")}}="
        },
        "CHAT_EVENT_ENCRYPTION_KEY": {
          "isOptional": false,
          "description": "Encrypts agent-builder chat history. Never change it once chats exist.",
          "defaultValue": "${{secret(43, \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\")}}="
        },
        "API_URL": {
          "isOptional": false,
          "description": "Public origin of the auth routes (the CRM app proxies /api to this service). Must match APP_URL.",
          "defaultValue": "https://${{CRM.RAILWAY_PUBLIC_DOMAIN}}"
        },
        "APP_URL": {
          "isOptional": false,
          "description": "Public address of the CRM. Change it to https://your-domain after adding a custom domain, here and on the CRM service.",
          "defaultValue": "https://${{CRM.RAILWAY_PUBLIC_DOMAIN}}"
        },
        "AGENT_URL": {
          "isOptional": false,
          "description": "The research agent on the private network.",
          "defaultValue": "http://${{Agent.RAILWAY_PRIVATE_DOMAIN}}:2000"
        },
        "NODE_ENV": {
          "isOptional": false,
          "description": "Do not change.",
          "defaultValue": "production"
        },
        "PORT": {
          "isOptional": false,
          "description": "Port of the API on the private network. Do not change.",
          "defaultValue": "3001"
        }
      },
      "networking": {
        "serviceDomains": {},
        "tcpProxies": {}
      }
    },
    "75587fbb-84ef-4db2-9f98-6de25cd5abed": {
      "icon": "https://raw.githubusercontent.com/trycompai/crm/v1.16.0/apps/app/public/web-app-manifest-512x512.png",
      "name": "Agent",
      "source": {
        "image": "ghcr.io/two-workspaces/comp-crm:6e9ed2c"
      },
      "deploy": {
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "variables": {
        "CRM_ROLE": {
          "isOptional": false,
          "description": "Runs the research agent. Do not change.",
          "defaultValue": "agent"
        },
        "AI_GATEWAY_API_KEY": {
          "isOptional": true,
          "description": "Vercel AI Gateway key for the agent's model (vercel.com/docs/ai-gateway). Without it the CRM works but the research agent can't run.",
          "defaultValue": ""
        },
        "PERPLEXITY_API_KEY": {
          "isOptional": true,
          "description": "Optional. Lets the agent search the web for people and news.",
          "defaultValue": ""
        },
        "DATABASE_URL": {
          "isOptional": false,
          "description": "Postgres connection.",
          "defaultValue": "${{Postgres.DATABASE_URL}}"
        },
        "BETTER_AUTH_SECRET": {
          "isOptional": false,
          "description": "Shared with the API, which signs sessions.",
          "defaultValue": "${{API.BETTER_AUTH_SECRET}}"
        },
        "ALLOWED_SIGN_IN": {
          "isOptional": false,
          "description": "Set on the API service.",
          "defaultValue": "${{API.ALLOWED_SIGN_IN}}"
        },
        "AGENT_BRIDGE_SECRET": {
          "isOptional": false,
          "description": "Shared with the API and the agent.",
          "defaultValue": "${{API.AGENT_BRIDGE_SECRET}}"
        },
        "MCP_ENCRYPTION_KEY": {
          "isOptional": false,
          "description": "Shared with the API.",
          "defaultValue": "${{API.MCP_ENCRYPTION_KEY}}"
        },
        "CHAT_EVENT_ENCRYPTION_KEY": {
          "isOptional": false,
          "description": "Shared with the API.",
          "defaultValue": "${{API.CHAT_EVENT_ENCRYPTION_KEY}}"
        },
        "API_URL": {
          "isOptional": false,
          "description": "The API on the private network.",
          "defaultValue": "http://${{API.RAILWAY_PRIVATE_DOMAIN}}:3001"
        },
        "APP_URL": {
          "isOptional": false,
          "description": "Public address of the CRM.",
          "defaultValue": "https://${{CRM.RAILWAY_PUBLIC_DOMAIN}}"
        },
        "WORKFLOW_LOCAL_DATA_DIR": {
          "isOptional": false,
          "description": "Where the agent keeps its durable sessions, on the volume. Do not change.",
          "defaultValue": "/data/workflow"
        },
        "AGENT_PORT": {
          "isOptional": false,
          "description": "Port of the agent on the private network. Do not change.",
          "defaultValue": "2000"
        },
        "HOST": {
          "isOptional": false,
          "description": "Listen on the private network. Do not change.",
          "defaultValue": "::"
        },
        "NODE_ENV": {
          "isOptional": false,
          "description": "Do not change.",
          "defaultValue": "production"
        }
      },
      "networking": {
        "serviceDomains": {},
        "tcpProxies": {}
      },
      "volumeMounts": {
        "f48f8bda-b424-4ee9-b69e-7a51d373f869": {
          "mountPath": "/data"
        }
      }
    },
    "58ebc763-0323-432a-8eda-b9158669a11b": {
      "icon": "https://raw.githubusercontent.com/trycompai/crm/v1.16.0/apps/app/public/web-app-manifest-512x512.png",
      "name": "Cron",
      "source": {
        "image": "ghcr.io/two-workspaces/comp-crm:6e9ed2c"
      },
      "deploy": {
        "cronSchedule": "*/5 * * * *",
        "restartPolicyType": "NEVER"
      },
      "variables": {
        "CRM_ROLE": {
          "isOptional": false,
          "description": "Runs the scheduled syncs. Do not change.",
          "defaultValue": "cron"
        },
        "CRM_API_INTERNAL_URL": {
          "isOptional": false,
          "description": "The API on the private network.",
          "defaultValue": "http://${{API.RAILWAY_PRIVATE_DOMAIN}}:3001"
        },
        "CRON_SECRET": {
          "isOptional": false,
          "description": "Shared with the API.",
          "defaultValue": "${{API.CRON_SECRET}}"
        }
      },
      "networking": {
        "serviceDomains": {},
        "tcpProxies": {}
      }
    },
    "8a284c6e-2a45-4550-bbe0-5d7003109f1c": {
      "icon": "https://devicons.railway.com/i/postgresql.svg",
      "name": "Postgres",
      "source": {
        "image": "ghcr.io/railwayapp-templates/postgres-ssl:17"
      },
      "deploy": {
        "requiredMountPath": "/var/lib/postgresql/data"
      },
      "variables": {
        "PGDATA": {
          "isOptional": false,
          "description": "Data directory.",
          "defaultValue": "/var/lib/postgresql/data/pgdata"
        },
        "PGHOST": {
          "isOptional": false,
          "description": "Host.",
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}"
        },
        "PGPORT": {
          "isOptional": false,
          "description": "Port.",
          "defaultValue": "5432"
        },
        "PGUSER": {
          "isOptional": false,
          "description": "User.",
          "defaultValue": "${{POSTGRES_USER}}"
        },
        "PGDATABASE": {
          "isOptional": false,
          "description": "Database.",
          "defaultValue": "${{POSTGRES_DB}}"
        },
        "PGPASSWORD": {
          "isOptional": false,
          "description": "Password.",
          "defaultValue": "${{POSTGRES_PASSWORD}}"
        },
        "POSTGRES_DB": {
          "isOptional": false,
          "description": "Database name.",
          "defaultValue": "crm"
        },
        "POSTGRES_USER": {
          "isOptional": false,
          "description": "Superuser.",
          "defaultValue": "postgres"
        },
        "POSTGRES_PASSWORD": {
          "isOptional": false,
          "description": "Superuser password.",
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\")}}"
        },
        "DATABASE_URL": {
          "isOptional": false,
          "description": "Connection string the CRM services use.",
          "defaultValue": "postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}"
        },
        "SSL_CERT_DAYS": {
          "isOptional": false,
          "description": "Days the self-signed certificate lasts.",
          "defaultValue": "820"
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "isOptional": false,
          "description": "Seconds Postgres gets to shut down cleanly.",
          "defaultValue": "60"
        }
      },
      "networking": {
        "serviceDomains": {},
        "tcpProxies": {}
      },
      "volumeMounts": {
        "4e6df5f4-09b9-4716-b6e5-bcaafef803f0": {
          "mountPath": "/var/lib/postgresql/data"
        }
      }
    }
  }
}